# Beispielkonfiguration – kopieren nach .env und anpassen.
# Alle Variablen tragen das Präfix IFS_.

IFS_ENVIRONMENT=dev
IFS_LOG_LEVEL=INFO

# --- Datenbank -------------------------------------------------------------
# In Produktion (IFS_ENVIRONMENT=prod) werden Default-Zugangsdaten (ifs:ifs)
# abgelehnt. Dann IFS_DB_PASSWORD ändern; docker-compose setzt die URL daraus
# zusammen. Ohne Docker ggf. IFS_DATABASE_URL passend setzen.
IFS_DB_PASSWORD=ifs
# IFS_DATABASE_URL=postgresql+psycopg://ifs:ifs@localhost:5432/ifs
IFS_AUTO_CREATE_SCHEMA=true

# --- Auth ------------------------------------------------------------------
# ZWINGEND: mindestens 32 Zeichen, z. B. `openssl rand -hex 32`.
# In Produktion (IFS_ENVIRONMENT=prod) verweigert der Start ohne starkes Secret.
IFS_JWT_SECRET=
IFS_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Objektspeicher (S3) ---------------------------------------------------
# Standard: lokales SeaweedFS (Daten bleiben im Volume s3-data erhalten).
# Setup erzeugt Zugangsdaten:  bash deploy/setup-seaweedfs.sh
# Für externes S3 (AWS/Ceph/Wasabi) Endpoint/Keys entsprechend setzen.
IFS_S3_ENDPOINT_URL=http://s3:8333
IFS_S3_REGION=us-east-1
IFS_S3_BUCKET=ifs
IFS_S3_ACCESS_KEY=
IFS_S3_SECRET_KEY=
IFS_S3_USE_SSL=false
IFS_S3_SSE=
IFS_S3_PRESIGN_TTL_SECONDS=300
IFS_CAS_DEDUP=true

# Storage-UI (SeaweedFS-Filer, Basic Auth) – nur für Admins.
IFS_S3_UI_USER=admin
IFS_S3_UI_PASSWORD=

# --- Uploads ---------------------------------------------------------------
IFS_UPLOAD_SPOOL_DIR=/var/lib/ifs/spool
# 0 = unbegrenzt. Wird vor dem Schreiben geprüft.
IFS_MAX_UPLOAD_SIZE=0
# Hartes Größenlimit für öffentliche Share-/Drop-Link-Uploads (Bytes).
# Greift zusätzlich zu IFS_MAX_UPLOAD_SIZE; 0 = unbegrenzt.
IFS_SHARE_UPLOAD_MAX_SIZE=104857600
# Rate-Limit für öffentliche Share-Uploads (pro Freigabe+IP).
IFS_SHARE_UPLOAD_MAX_REQUESTS=60
IFS_SHARE_UPLOAD_WINDOW_SECONDS=300
# Rate-Limit für anonyme Downloads von Veröffentlichungen (pro Eintrag+IP).
IFS_PUBLISHED_DOWNLOAD_MAX_REQUESTS=120
IFS_PUBLISHED_DOWNLOAD_WINDOW_SECONDS=300
# Gesamt-Quota pro Besitzer in Bytes (0 = unbegrenzt).
IFS_DEFAULT_QUOTA_BYTES=0

# --- Login-Schutz (Brute-Force) --------------------------------------------
IFS_LOGIN_MAX_ATTEMPTS=5
IFS_LOGIN_IP_MAX_ATTEMPTS=20
IFS_LOGIN_WINDOW_SECONDS=300
IFS_LOGIN_LOCK_SECONDS=30
IFS_LOGIN_MAX_LOCK_SECONDS=900

# Nur wenn der direkte Peer in dieser Liste liegt (CIDR, kommagetrennt),
# wird X-Forwarded-For für die Client-IP im Audit berücksichtigt.
# ACHTUNG hinter einem Reverse-Proxy: Ohne diese Einstellung teilen alle
# Clients die Proxy-IP – Rate-Limit und Login-Sperre wirken dann global statt
# pro Client. Die Proxy-Netze (z. B. 172.16.0.0/12) hier eintragen.
IFS_TRUSTED_PROXIES=

# Info-Endpunkte. Standardmäßig deaktiviert bzw. nur für Admins.
IFS_EXPOSE_DOCS=false
IFS_METRICS_PUBLIC=false
# Pfad für die Speicherbelegungs-Anzeige im Admin-Panel.
IFS_MONITOR_DISK_PATH=/
# Optional: SeaweedFS-Volume-Status für das Admin-Panel (nur bei lokalem SeaweedFS).
IFS_SEAWEEDFS_STATUS_URL=http://s3:9333/vol/status

# --- Papierkorb ------------------------------------------------------------
IFS_TRASH_RETENTION_DAYS=30

# --- FTPS ------------------------------------------------------------------
IFS_FTP_ENABLED=true
IFS_FTP_HOST=0.0.0.0
IFS_FTP_PORT=21
IFS_FTP_PASSIVE_PORTS=30000-30100
# Nach außen sichtbare FTPS-Adresse. Im Docker-/NAT-Betrieb ZWINGEND setzen,
# sonst meldet PASV die Container-IP und der Datenkanal bricht ab.
# Beispiel: die IP oder der Hostname, den die Clients verwenden.
# IFS_FTP_MASQUERADE_ADDRESS=files.example.org
IFS_FTP_CERTFILE=/etc/ifs/ftps.crt
IFS_FTP_KEYFILE=/etc/ifs/ftps.key

# --- Admin-Erstinitialisierung ---------------------------------------------
# Nur wenn ein Passwort gesetzt ist (mind. 8 Zeichen), wird beim ersten Start
# ein Admin angelegt. Ohne Passwort wird kein Admin erstellt.
IFS_ADMIN_USERNAME=admin
IFS_ADMIN_PASSWORD=
